/* ============================================================
   印流PDflow - 全局样式表 global.qss
   设计规范来源: DESIGN.md
   框架: PySide6 (Qt for Python)
   默认主题: 深色模式
   ============================================================ */

/* ============================================================
   一、全局基础设置
   ============================================================ */

QWidget {
    background-color: {{bg}};
    color: {{text_main}};
    font-family: "Microsoft YaHei", "PingFang SC", "Inter", "Segoe UI", sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: {{bg}};
}

QDialog {
    background-color: {{bg}};
}

/* 中央容器 */
QWidget#centralWidget {
    background-color: {{bg}};
    border-radius: 8px;
}

/* 自定义标题栏 */
QWidget#titleBar {
    background-color: {{bg}};
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

/* ============================================================
   二、字体层级
   H1: 24px Bold | H2: 18px SemiBold | H3: 15px SemiBold
   Body: 14px Regular (默认) | Caption: 12px Regular
   Button: 14px Medium | Monospace: JetBrains Mono
   ============================================================ */

QLabel#headingH1 {
    font-size: 24px;
    font-weight: 700;
    color: {{text_main}};
}

QLabel#headingH2 {
    font-size: 18px;
    font-weight: 600;
    color: {{text_main}};
}

QLabel#headingH3 {
    font-size: 15px;
    font-weight: 600;
    color: {{text_main}};
}

QLabel#caption {
    font-size: 12px;
    color: {{text_sub}};
}

QLabel#monospace,
QLineEdit#monospace,
QTextEdit#monospace {
    font-family: "JetBrains Mono", "Consolas", "Courier New", monospace;
}

/* ============================================================
   三、按钮系统
   主要按钮: {{primary}} 背景，白色文字，8px 圆角
   次要按钮: 透明背景，主题色边框，8px 圆角
   危险按钮: {{error}} 背景，白色文字，8px 圆角
   文字按钮: 透明背景，主题色文字
   ============================================================ */

/* --- 主要按钮 --- */
QPushButton#primaryButton,
QPushButton[cssClass="primary"] {
    background-color: {{primary}};
    color: {{white}};
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    min-height: 36px;
}

QPushButton#primaryButton:hover,
QPushButton[cssClass="primary"]:hover {
    background-color: {{primary_hover}};
}

QPushButton#primaryButton:pressed,
QPushButton[cssClass="primary"]:pressed {
    background-color: {{primary_pressed}};
}

QPushButton#primaryButton:disabled,
QPushButton[cssClass="primary"]:disabled {
    background-color: {{primary}};
    color: {{white}};
}

/* --- 次要按钮 --- */
QPushButton#secondaryButton,
QPushButton[cssClass="secondary"] {
    background-color: transparent;
    color: {{primary}};
    border: 1px solid {{primary}};
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    min-height: 36px;
}

QPushButton#secondaryButton:hover,
QPushButton[cssClass="secondary"]:hover {
    background-color: {{primary_light_10}};
}

QPushButton#secondaryButton:pressed,
QPushButton[cssClass="secondary"]:pressed {
    background-color: {{primary_light_20}};
}

QPushButton#secondaryButton:disabled,
QPushButton[cssClass="secondary"]:disabled {
    color: {{primary}};
    border-color: {{primary}};
}

/* --- 危险按钮 --- */
QPushButton#dangerButton,
QPushButton[cssClass="danger"] {
    background-color: {{error}};
    color: {{white}};
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    min-height: 36px;
}

QPushButton#dangerButton:hover,
QPushButton[cssClass="danger"]:hover {
    background-color: {{error_hover}};
}

QPushButton#dangerButton:pressed,
QPushButton[cssClass="danger"]:pressed {
    background-color: {{error_pressed}};
}

QPushButton#dangerButton:disabled,
QPushButton[cssClass="danger"]:disabled {
    background-color: {{error}};
}

/* --- 文字按钮 --- */
QPushButton#textButton,
QPushButton[cssClass="text"] {
    background-color: transparent;
    color: {{primary}};
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    font-weight: 500;
    min-height: 36px;
}

QPushButton#textButton:hover,
QPushButton[cssClass="text"]:hover {
    background-color: {{primary_light_10}};
}

QPushButton#textButton:disabled,
QPushButton[cssClass="text"]:disabled {
    color: {{primary}};
}

/* --- 紧凑按钮 (32px 高度) --- */
QPushButton#compactButton,
QPushButton[cssClass="compact"] {
    min-height: 32px;
    padding: 6px 12px;
    font-size: 13px;
}

/* ============================================================
   四、输入框与选择器
   背景: {{input_bg}}，边框: 1px solid {{border}}，圆角: 6px
   高度: 36px，聚焦态: 边框主题色
   ============================================================ */

QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: {{input_bg}};
    color: {{text_main}};
    border: 1px solid {{border}};
    border-radius: 6px;
    padding: 0 12px;
    min-height: 36px;
    font-size: 14px;
    selection-background-color: {{primary}};
    selection-color: {{white}};
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid {{primary}};
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: {{card_bg}};
    color: {{text_muted}};
    border-color: {{border}};
}

/* 占位文字 */
QLineEdit:placeholder,
QTextEdit:placeholder,
QPlainTextEdit:placeholder {
    color: {{placeholder_text}};
}

/* 多行输入内边距 */
QTextEdit,
QPlainTextEdit {
    padding: 8px 12px;
}

/* --- 下拉框 --- */
QComboBox {
    background-color: {{input_bg}};
    color: {{text_main}};
    border: 1px solid {{border}};
    border-radius: 6px;
    padding: 0 12px;
    min-height: 36px;
    font-size: 14px;
}

QComboBox:hover {
    border: 1px solid {{primary}};
}

QComboBox:focus {
    border: 1px solid {{primary}};
}

QComboBox:disabled {
    background-color: {{card_bg}};
    color: {{text_muted}};
    border-color: {{border}};
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid {{border}};
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
    border: 5px solid transparent;
    border-top-color: {{text_sub}};
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: {{card_bg}};
    color: {{text_main}};
    border: 1px solid {{border}};
    border-radius: 6px;
    selection-background-color: {{hover_bg}};
    selection-color: {{primary}};
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    min-height: 32px;
    padding: 4px 12px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: {{bg_hover}};
    color: {{text_main}};
}

/* --- 数值输入 --- */
QSpinBox,
QDoubleSpinBox {
    background-color: {{input_bg}};
    color: {{text_main}};
    border: 1px solid {{border}};
    border-radius: 6px;
    padding: 0 12px;
    min-height: 36px;
    font-size: 14px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid {{primary}};
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid {{border}};
    border-top-right-radius: 6px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 24px;
    border-left: 1px solid {{border}};
    border-bottom-right-radius: 6px;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    width: 0;
    height: 0;
    border: 4px solid transparent;
    border-bottom-color: {{text_sub}};
    margin: 4px auto 0;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 0;
    height: 0;
    border: 4px solid transparent;
    border-top-color: {{text_sub}};
    margin: 0 auto 4px;
}

/* ============================================================
   五、卡片/容器
   背景: {{card_bg}}，圆角: 12px，边框: 1px solid {{border}}
   内边距: 20px
   ============================================================ */

QFrame#card,
QGroupBox#card,
QWidget#card {
    background-color: {{card_bg}};
    border: 1px solid {{border}};
    border-radius: 8px;
    padding: 20px;
}

QFrame#card:hover,
QGroupBox#card:hover,
QWidget#card:hover {
    background-color: {{hover_bg}};
    border: 1px solid {{primary}};
}

/* 小卡片 (8px 圆角) */
QFrame#smallCard,
QGroupBox#smallCard {
    background-color: {{card_bg}};
    border: 1px solid {{border}};
    border-radius: 8px;
    padding: 16px;
}

/* 容器背景 */
QFrame#container,
QGroupBox#container {
    background-color: {{card_bg}};
    border: none;
    border-radius: 8px;
    padding: 16px;
}

/* ============================================================
   六、标签页
   ============================================================ */

QTabWidget::pane {
    background-color: {{input_bg}};
    border: 1px solid {{border}};
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: {{bg_normal}};
    color: {{text_sub}};
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    min-height: 28px;
    font-size: 14px;
    font-weight: 500;
}

QTabBar::tab:hover {
    color: {{text_main}};
    background-color: {{bg_hover}};
    border-radius: 4px 4px 0 0;
}

QTabBar::tab:selected {
    color: {{text_selected}};
    background-color: {{bg_selected}};
    border-bottom: 2px solid {{border_selected}};
    font-weight: 600;
}

/* ============================================================
   七、侧边导航栏
   背景: {{nav_bg}}，菜单项高度 44px，选中态左侧 3px 主题色竖线
   ============================================================ */

QListWidget#sidebar,
QTreeWidget#sidebar {
    background-color: {{nav_bg}};
    border: none;
    outline: none;
    padding: 0;
}

QListWidget#sidebar::item,
QTreeWidget#sidebar::item {
    min-height: 44px;
    padding-left: 16px;
    color: {{text_sub}};
    font-size: 14px;
    font-weight: 400;
    border: none;
    border-radius: 0;
    background-color: {{bg_normal}};
}

QListWidget#sidebar::item:hover,
QTreeWidget#sidebar::item:hover {
    background-color: {{bg_hover}};
    color: {{text_main}};
}

QListWidget#sidebar::item:selected,
QTreeWidget#sidebar::item:selected {
    background-color: {{bg_selected}};
    color: {{text_selected}};
    font-weight: 500;
    border-left: 3px solid {{border_selected}};
    padding-left: 13px;
}

/* ============================================================
   八、标签与徽章 (圆角: 4px)
   ============================================================ */

QLabel#badge,
QLabel[cssClass="badge"] {
    background-color: {{badge_bg}};
    color: {{primary}};
    border: none;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
    font-weight: 500;
}

QLabel#badgeSuccess,
QLabel[cssClass="badge-success"] {
    background-color: {{success_light_15}};
    color: {{success}};
    border: none;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
}

QLabel#badgeWarning,
QLabel[cssClass="badge-warning"] {
    background-color: {{warning_light_15}};
    color: {{warning}};
    border: none;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
}

QLabel#badgeDanger,
QLabel[cssClass="badge-danger"] {
    background-color: {{error_light_15}};
    color: {{error}};
    border: none;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
}

/* ============================================================
   九、滚动条 (8px 宽，暗色滑块)
   ============================================================ */

QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: {{border}};
    border-radius: 4px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background-color: {{text_muted}};
}

QScrollBar::handle:vertical:pressed {
    background-color: {{text_sub}};
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: {{border}};
    border-radius: 4px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background-color: {{text_muted}};
}

QScrollBar::handle:horizontal:pressed {
    background-color: {{text_sub}};
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ============================================================
   十、菜单栏与菜单
   ============================================================ */

QMenuBar {
    background-color: {{nav_bg}};
    color: {{text_sub}};
    border: none;
    border-bottom: 1px solid {{border}};
    padding: 2px 0;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: {{bg_selected}};
    color: {{text_selected}};
}

QMenu {
    background-color: {{card_bg}};
    border: 1px solid {{border}};
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 32px 8px 12px;
    border-radius: 4px;
    min-height: 28px;
    color: {{text_main}};
}

QMenu::item:selected {
    background-color: {{bg_selected}};
    color: {{text_selected}};
}

QMenu::item:disabled {
    color: {{text_muted}};
}

QMenu::separator {
    height: 1px;
    background-color: {{border}};
    margin: 4px 8px;
}

/* ============================================================
   十一、ToolTip
   ============================================================ */

QToolTip {
    background-color: {{card_bg}};
    color: {{text_main}};
    border: 1px solid {{border}};
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ============================================================
   十二、分组框
   ============================================================ */

QGroupBox {
    background-color: transparent;
    border: 1px solid {{border}};
    border-radius: 8px;
    margin-top: 20px;
    padding: 20px 16px 16px;
    font-size: 14px;
    font-weight: 600;
    color: {{text_main}};
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    background-color: transparent;
    color: {{text_main}};
}

/* ============================================================
   十三、进度条 (6px 高)
   ============================================================ */

QProgressBar {
    background-color: {{border}};
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
    text-align: center;
    font-size: 10px;        /* V1.1 Theme Recovery: 改 0 → 10px 避免 QFont::setPointSize <= 0 警告 */
    color: transparent;     /* 透明色让 6px 进度条内的文字视觉隐藏 */
}

QProgressBar::chunk {
    background-color: {{primary}};
    border-radius: 3px;
}

/* ============================================================
   十四、复选框与单选按钮
   ============================================================ */

QCheckBox,
QRadioButton {
    spacing: 8px;
    color: {{text_main}};
    font-size: 14px;
    min-height: 24px;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: {{text_muted}};
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked {
    border: 2px solid {{text_muted}};
    border-radius: 3px;
    background-color: transparent;
}

QCheckBox::indicator:unchecked:hover {
    border: 2px solid {{primary}};
}

QCheckBox::indicator:checked {
    border: 2px solid {{primary}};
    border-radius: 3px;
    background-color: {{primary}};
}

QRadioButton::indicator:unchecked {
    border: 2px solid {{text_muted}};
    border-radius: 9px;
    background-color: transparent;
}

QRadioButton::indicator:unchecked:hover {
    border: 2px solid {{primary}};
}

QRadioButton::indicator:checked {
    border: 2px solid {{primary}};
    border-radius: 9px;
    background-color: {{primary}};
}

/* ============================================================
   十五、滑块
   ============================================================ */

QSlider::groove:horizontal {
    background-color: {{border}};
    border: none;
    border-radius: 3px;
    height: 6px;
}

QSlider::handle:horizontal {
    background-color: {{primary}};
    border: none;
    border-radius: 8px;
    width: 16px;
    height: 16px;
    margin: -5px 0;
}

QSlider::handle:horizontal:hover {
    background-color: {{primary_hover}};
}

QSlider::sub-page:horizontal {
    background-color: {{primary}};
    border-radius: 3px;
}

QSlider::groove:vertical {
    background-color: {{border}};
    border: none;
    border-radius: 3px;
    width: 6px;
}

QSlider::handle:vertical {
    background-color: {{primary}};
    border: none;
    border-radius: 8px;
    width: 16px;
    height: 16px;
    margin: 0 -5px;
}

QSlider::handle:vertical:hover {
    background-color: {{primary_hover}};
}

QSlider::sub-page:vertical {
    background-color: {{primary}};
    border-radius: 3px;
}

/* ============================================================
   十六、分割器
   ============================================================ */

QSplitter::handle {
    background-color: {{border}};
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background-color: {{primary}};
}

/* ============================================================
   十七、表格视图
   ============================================================ */

QTableView,
QTableWidget {
    background-color: {{input_bg}};
    color: {{text_main}};
    border: 1px solid {{border}};
    border-radius: 6px;
    gridline-color: {{border}};
    selection-background-color: {{primary_light_12}};
    selection-color: {{text_main}};
    font-size: 13px;
}

QTableView::item,
QTableWidget::item {
    padding: 6px 12px;
    border-bottom: 1px solid {{border}};
}

QTableView::item:hover,
QTableWidget::item:hover {
    background-color: {{hover_bg}};
}

QTableView::item:selected,
QTableWidget::item:selected {
    background-color: {{bg_selected}};
    color: {{text_selected}};
}

QHeaderView::section {
    background-color: {{nav_bg}};
    color: {{text_sub}};
    border: none;
    border-bottom: 1px solid {{border}};
    border-right: 1px solid {{border}};
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
}

QHeaderView::section:hover {
    color: {{text_main}};
}

/* ============================================================
   十八、状态栏
   ============================================================ */

QStatusBar {
    background-color: {{nav_bg}};
    color: {{text_sub}};
    border-top: 1px solid {{border}};
    font-size: 12px;
    padding: 2px 12px;
}

/* ============================================================
   十九、语义色文字
   ============================================================ */

QLabel#successText,
QLabel[cssClass="text-success"] {
    color: {{success}};
}

QLabel#warningText,
QLabel[cssClass="text-warning"] {
    color: {{warning}};
}

QLabel#errorText,
QLabel[cssClass="text-danger"] {
    color: {{error}};
}

/* ============================================================
   二十、首页组件样式（FunctionCard / recentSection / FileItem）
   ============================================================ */

/* 功能卡片 */
QFrame#funcCard {
    background: {{func_card_bg_qss}};
    border: 1px solid {{white_13_qss}};
    border-radius: 16px;
}

QFrame#funcCard:hover {
    background: {{func_card_hover_qss}};
    border: 1px solid {{func_card_border_hover_qss}};
}

/* 图标容器 */
QFrame#cardIconFrame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 {{gradient_start_qss}},
        stop:1 {{gradient_end_qss}});
    border: 1px solid {{gradient_border_qss}};
    border-radius: 8px;
}

/* 卡片标题 / 描述 */
QLabel#cardTitle {
    color: {{card_title}};
    font-size: 15px;
    font-weight: 600;
}

QLabel#cardDesc {
    color: {{text_sub}};
    font-size: 12px;
}

/* 最近文件容器 */
QFrame#recentSection {
    background-color: {{recent_bg_qss}};
    border: 1px solid {{white_15_qss}};
    border-radius: 16px;
}

/* 文件列表项 */
QFrame#fileItem {
    background: transparent;
    border: none;
    border-radius: 6px;
}

QFrame#fileItem:hover {
    background: {{white_8_qss}};
}

/* 文件名 / 元信息 */
QLabel#fileName {
    color: {{card_title}};
    font-size: 13px;
    font-weight: 500;
}

QLabel#fileMeta {
    color: {{text_sub}};
    font-size: 11px;
}

/* PDF 图标 */
QFrame#pdfIcon {
    background: {{pdf_icon_blue_bg_qss}};
    border: 1px solid {{nav_checked_bg_qss}};
    border-radius: 4px;
}

QFrame#pdfIcon[variant="red"] {
    background: {{pdf_icon_red_bg_qss}};
    border: 1px solid {{pdf_icon_red_border_qss}};
}

/* 清空记录按钮 */
QPushButton#clearBtn {
    color: {{text_sub}};
    font-size: 12px;
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 10px;
}

QPushButton#clearBtn:hover {
    color: {{card_title}};
    background: {{white_8_qss}};
}

/* 首页滚动区域 */
QScrollArea#homeScrollArea {
    border: none;
    background: transparent;
}

QScrollArea#homeScrollArea > QWidget > QWidget {
    background: transparent;
}

/* 首页背景 */
HomePage {
    background-color: {{bg}};
}

/* ============================================================
   二一、侧边栏导航按钮
   ============================================================ */

/* 侧边栏 */
QWidget#sidebar {
    background-color: {{nav_bg}};
    border-right: 1px solid {{white_8_qss}};
}

/* 侧边栏 LOGO 标题 */
QLabel#navTitle {
    color: {{text_main}};
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.3px;
    background: transparent;
    border: none;
}

QLabel#navLogo {
    background: transparent;
    border: none;
}

/* 侧边栏导航按钮（通用 objectName=navButton） */
QPushButton#navButton {
    color: {{sidebar_text}};
    background-color: {{bg_normal}};
    text-align: left;
    padding-left: 12px;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    min-height: 40px;
    max-height: 40px;
    margin: 0px 10px;
}

QPushButton#navButton:hover {
    color: {{text_hover}};
    background-color: {{bg_hover}};
}

QPushButton#navButton:checked {
    color: {{text_selected}};
    background-color: {{bg_selected}};
    border: 1px solid {{border_selected}};
    font-weight: 600;
}

/* 侧边栏导航按钮 */
QPushButton#btnHome,
QPushButton#btnMerge,
QPushButton#btnCompress,
QPushButton#btnConvert,
QPushButton#btnWatermark,
QPushButton#btnTemplateLayout,
QPushButton#btnSpeedwrite {
    color: {{sidebar_text}};
    background-color: {{bg_normal}};
    text-align: left;
    padding: 10px 16px;
    border: none;
    border-radius: 8px;
    font-size: 14px;
}

QPushButton#btnHome:hover,
QPushButton#btnMerge:hover,
QPushButton#btnCompress:hover,
QPushButton#btnConvert:hover,
QPushButton#btnWatermark:hover,
QPushButton#btnTemplateLayout:hover,
QPushButton#btnSpeedwrite:hover {
    background-color: {{bg_hover}};
    color: {{text_hover}};
}

QPushButton#btnHome:checked,
QPushButton#btnMerge:checked,
QPushButton#btnCompress:checked,
QPushButton#btnConvert:checked,
QPushButton#btnWatermark:checked,
QPushButton#btnTemplateLayout:checked,
QPushButton#btnSpeedwrite:checked {
    color: {{text_selected}};
    background-color: {{bg_selected}};
    border-left: 3px solid {{border_selected}};
    font-weight: 600;
}

/* 导航图标（QLabel#navIcon）*/
QLabel#navIcon {
    background: transparent;
    border: none;
}

/* 侧边栏底部 */
QFrame#sidebarFooter {
    background-color: transparent;
    border-top: 1px solid {{white_8_qss}};
}

/* 设置按钮 */
QPushButton#btnSettings {
    color: {{sidebar_text}};
    background-color: transparent;
    text-align: left;
    padding: 0px 14px;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    min-height: 44px;
    max-height: 44px;
    margin: 1px 10px;
}

QPushButton#btnSettings:hover {
    color: {{sidebar_text_active}};
    background-color: {{nav_hover_qss}};
}

/* 内容区域 */
QWidget#contentArea {
    background-color: {{bg}};
}

QLabel#contentTitle {
    color: {{text_main}};
    font-size: 24px;
    font-weight: bold;
    padding: 24px;
}

/* 页面容器 */
QWidget#pageContainer {
    background-color: {{bg}};
}

/* 状态栏 */
QStatusBar {
    background-color: {{card_bg}};
    color: {{text_sub}};
    border-top: 1px solid {{border}};
}

/* ============================================================
   二二、模板排版模式切换按钮（TPL-02 新增）
   ============================================================ */

/* 模式切换容器 */
QFrame#modeSwitchFrame {
    background-color: {{card_bg}};
    border: 1px solid {{border}};
    border-radius: 8px;
    padding: 4px;
}

/* 模式切换按钮：未选中 */
QPushButton#btnTemplateMode,
QPushButton#btnFreewriteMode {
    background-color: transparent;
    color: {{sidebar_text}};
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
    padding: 6px 20px;
}

QPushButton#btnTemplateMode:hover,
QPushButton#btnFreewriteMode:hover {
    color: {{card_title}};
}

/* 模式切换按钮：选中（由 setChecked/setStyleSheet 动态设置） */
QPushButton#btnTemplateMode:checked,
QPushButton#btnFreewriteMode:checked {
    background-color: {{primary}};
    color: {{white}};
}

/* 编辑器页面按钮 */
QPushButton#backBtn {
    background-color: transparent;
    color: {{sidebar_text}};
    border: 1px solid {{border}};
    border-radius: 6px;
    font-size: 13px;
    padding: 6px 16px;
}

QPushButton#backBtn:hover {
    color: {{card_title}};
    border-color: {{primary}};
}

QPushButton#backBtn:pressed {
    background-color: {{hover_bg}};
    border-color: {{primary}};
}

QPushButton#resetBtn {
    background-color: transparent;
    color: {{sidebar_text}};
    border: 1px solid {{border}};
    border-radius: 6px;
    font-size: 14px;
}

QPushButton#resetBtn:hover {
    color: {{card_title}};
    border-color: {{primary}};
}

QPushButton#resetBtn:pressed {
    background-color: {{hover_bg}};
    border-color: {{primary}};
}

QPushButton#generateBtn {
    background-color: {{primary}};
    color: {{white}};
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    padding: 0 24px;
    min-height: 40px;
}

QPushButton#generateBtn:hover {
    background-color: {{primary_hover}};
}

QPushButton#generateBtn:pressed {
    background-color: {{primary_pressed_alt}};
}

QPushButton#generateBtn:disabled {
    background-color: {{border_light}};
    color: {{text_muted}};
}

/* 面包屑导航 */
QLabel#breadcrumbLabel {
    background-color: transparent;
}

/* 分组标题 */
QLabel#groupTitle {
    background-color: transparent;
}

/* 预览面板标题 */
QLabel#previewTitle {
    background-color: transparent;
}

/* 预览面板信息 */
QLabel#previewInfo {
    background-color: transparent;
}

/* 实时预览视图 */
QWebEngineView#previewView {
    background-color: {{preview_bg}};
}
