  <property name="styleSheet">
   <string notr="true">QWidget#MergePage {
    background-color: #0B0E11;
}

/* ===== 主要按钮样式 ===== */
QPushButton#btnAddPdf, QPushButton#btnMergePdf {
    background-color: #4D7CFE;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    font-family: &quot;Inter&quot;, &quot;微软雅黑&quot;;
    font-size: 14px;
    font-weight: 500;
    padding: 8px 20px;
}

QPushButton#btnAddPdf:hover, QPushButton#btnMergePdf:hover {
    background-color: #3D6CF0;
}

QPushButton#btnAddPdf:pressed, QPushButton#btnMergePdf:pressed {
    background-color: #3560E0;
}

/* ===== 文字按钮样式（清空全部） ===== */
QPushButton#btnClearAll {
    background-color: transparent;
    color: #848E9C;
    border: none;
    border-radius: 8px;
    font-family: &quot;Inter&quot;, &quot;微软雅黑&quot;;
    font-size: 14px;
    padding: 8px 16px;
}

QPushButton#btnClearAll:hover {
    color: #EAECEF;
}

/* ===== 次要按钮样式（合并/拆分） ===== */
QPushButton#btnMerge, QPushButton#btnSplit {
    background-color: #1E2329;
    color: #EAECEF;
    border: 1px solid #2B3139;
    border-radius: 8px;
    font-family: &quot;Inter&quot;, &quot;微软雅黑&quot;;
    font-size: 14px;
    padding: 6px 20px;
}

QPushButton#btnMerge:hover, QPushButton#btnSplit:hover {
    background-color: #282D35;
    border-color: #3D4450;
}

/* ===== 文件列表样式 ===== */
QListWidget#fileListWidget {
    background-color: #1A1A22;
    border: 1px solid #2B3139;
    border-radius: 8px;
    font-family: &quot;Inter&quot;, &quot;微软雅黑&quot;;
    font-size: 14px;
    color: #EAECEF;
    outline: none;
    padding: 4px;
}

QListWidget#fileListWidget::item {
    height: 44px;
    border-radius: 6px;
    padding: 0px 12px;
    color: #EAECEF;
}

QListWidget#fileListWidget::item:hover {
    background-color: #1E2329;
}

QListWidget#fileListWidget::item:selected {
    background-color: #2A3040;
    color: #FFFFFF;
}

/* ===== 状态标签 ===== */
QLabel#lblFileCount {
    color: #848E9C;
    font-family: &quot;Inter&quot;, &quot;微软雅黑&quot;;
    font-size: 13px;
}

QLabel#lblHint {
    color: #848E9C;
    font-family: &quot;Inter&quot;, &quot;微软雅黑&quot;;
    font-size: 13px;
}</string>
