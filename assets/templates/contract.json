{
  "id": "contract",
  "name": "合同协议",
  "icon": "📋",
  "description": "标准合同协议模板，支持甲乙方信息、条款列表、签章区域",
  "type": "商务",
  "version": "1.0",
  "sample": {
    "title": "服务合同",
    "contract_no": "HT-2026-001",
    "party_a": "示例科技有限公司",
    "party_a_addr": "北京市朝阳区xx路1号",
    "party_b": "客户企业有限公司",
    "party_b_addr": "上海市浦东新区xx路2号",
    "date": "2026年6月3日",
    "terms": "第一条  双方应严格遵守本合同约定。\n第二条  服务内容详见附件A。\n第三条  付款方式：合同签订后7日内支付50%预付款，验收合格后支付50%尾款。\n第四条  双方对合作过程中知悉的对方商业秘密负有保密义务。\n第五条  因履行本合同发生的争议，提交北京仲裁委员会仲裁。",
    "amount": "¥100,000.00",
    "remark": "本合同自双方签字盖章之日起生效。"
  },
  "fields": [
    {"key": "title", "label": "合同名称", "type": "text", "required": true, "maxLength": 50, "placeholder": "输入合同名称", "default": "服务合同"},
    {"key": "contract_no", "label": "合同编号", "type": "text", "required": false, "maxLength": 30, "placeholder": "HT-2026-001"},
    {"key": "party_a", "label": "甲方", "type": "text", "required": true, "maxLength": 50, "placeholder": "甲方名称"},
    {"key": "party_a_addr", "label": "甲方地址", "type": "text", "required": false, "maxLength": 100, "placeholder": "甲方地址"},
    {"key": "party_b", "label": "乙方", "type": "text", "required": true, "maxLength": 50, "placeholder": "乙方名称"},
    {"key": "party_b_addr", "label": "乙方地址", "type": "text", "required": false, "maxLength": 100, "placeholder": "乙方地址"},
    {"key": "date", "label": "签订日期", "type": "text", "required": false, "maxLength": 30, "placeholder": "2026年1月1日"},
    {"key": "terms", "label": "合同条款", "type": "textarea", "required": true, "placeholder": "每行一条条款"},
    {"key": "amount", "label": "合同金额", "type": "text", "required": false, "maxLength": 30, "placeholder": "¥10,000.00"},
    {"key": "remark", "label": "备注", "type": "textarea", "required": false, "placeholder": "补充说明"}
  ],
  "style_options": {
    "theme_color": {
      "label": "主题色",
      "type": "color_preset",
      "default": "#2C3E6B",
      "options": [
        {"name": "商务蓝", "value": "#2C3E6B"},
        {"name": "高级黑", "value": "#1A1A22"},
        {"name": "中国红", "value": "#8B0000"},
        {"name": "墨绿", "value": "#1B4332"}
      ]
    },
    "header_style": {
      "label": "标题栏样式",
      "type": "select",
      "default": "bar",
      "options": [
        {"name": "装饰条", "value": "bar"},
        {"name": "色块", "value": "color_block"},
        {"name": "无", "value": "none"}
      ]
    },
    "bg_style": {
      "label": "背景样式",
      "type": "select",
      "default": "white",
      "options": [
        {"name": "纯白", "value": "white"},
        {"name": "浅灰", "value": "light_gray"},
        {"name": "浅蓝", "value": "light_blue"}
      ]
    }
  }
}
