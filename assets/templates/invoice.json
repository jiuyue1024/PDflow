{
  "id": "invoice",
  "name": "发票收据",
  "icon": "🧾",
  "description": "标准发票/收据模板，支持明细表格、合计金额、开票信息",
  "type": "财务",
  "version": "1.0",
  "sample": {
    "title": "发票",
    "invoice_no": "INV-2026-001",
    "date": "2026年6月3日",
    "seller": "示例科技有限公司",
    "seller_addr": "北京市朝阳区xx路1号  010-12345678",
    "buyer": "客户企业有限公司",
    "buyer_addr": "上海市浦东新区xx路2号",
    "items": [
      {"name": "设计服务", "qty": "1", "price": "80000.00"},
      {"name": "技术咨询", "qty": "2", "price": "10000.00"}
    ],
    "total_amount": "¥100,000.00",
    "remark": "本发票为增值税普通发票"
  },
  "fields": [
    {"key": "title", "label": "票据标题", "type": "text", "required": true, "maxLength": 20, "placeholder": "发票/收据", "default": "发票"},
    {"key": "invoice_no", "label": "票据编号", "type": "text", "required": false, "maxLength": 30, "placeholder": "INV-2026-001"},
    {"key": "date", "label": "开票日期", "type": "text", "required": false, "maxLength": 30, "placeholder": "2026年1月1日"},
    {"key": "seller", "label": "销售方", "type": "text", "required": true, "maxLength": 50, "placeholder": "销售方名称"},
    {"key": "seller_addr", "label": "销售方地址", "type": "text", "required": false, "maxLength": 100, "placeholder": "地址电话"},
    {"key": "buyer", "label": "购买方", "type": "text", "required": true, "maxLength": 50, "placeholder": "购买方名称"},
    {"key": "buyer_addr", "label": "购买方地址", "type": "text", "required": false, "maxLength": 100, "placeholder": "地址电话"},
    {"key": "items", "label": "明细项目", "type": "textarea", "required": true, "placeholder": "点击「+ 新增项目」添加明细行"},
    {"key": "total_amount", "label": "合计金额", "type": "text", "required": false, "maxLength": 30, "placeholder": "¥10,000.00"},
    {"key": "remark", "label": "备注", "type": "textarea", "required": false, "maxLength": 120, "placeholder": "备注信息（最多120字）"}
  ],
  "style_options": {
    "theme_color": {
      "label": "主题色",
      "type": "color_preset",
      "default": "#8B0000",
      "options": [
        {"name": "中国红", "value": "#8B0000"},
        {"name": "商务蓝", "value": "#1A5276"},
        {"name": "墨黑", "value": "#1A1A22"},
        {"name": "墨绿", "value": "#0E6655"}
      ]
    },
    "border_style": {
      "label": "边框样式",
      "type": "select",
      "default": "double",
      "options": [
        {"name": "双线边框", "value": "double"},
        {"name": "单线边框", "value": "single"},
        {"name": "无边框", "value": "none"}
      ]
    },
    "bg_style": {
      "label": "背景样式",
      "type": "select",
      "default": "white",
      "options": [
        {"name": "纯白", "value": "white"},
        {"name": "浅灰", "value": "light_gray"}
      ]
    }
  }
}
